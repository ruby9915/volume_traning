"><mxGeometry y="-16" relative="1" as="geometry"/></mxCell><mxCell id="r16" value="⑯ 참고 타겟이다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;dashed=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="muscle" target="mach"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="92" y="930"/><mxPoint x="1195" y="930"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;★ 식별자 · (FK) 외래키&lt;br&gt;{다중값} 다중값 속성&lt;br&gt;관계 이름 아래 { } = 관계 설명 속성&lt;br&gt;번호 = 최종 관계 목록의 관계 번호&lt;br&gt;실선 = 식별 관계 · 점선 = 비식별 관계&lt;br&gt;|| 정확히 1(필수) · O| 0 또는 1(선택)&lt;br&gt;O&amp;lt; 0 이상(선택)&lt;br&gt;M:N 관계 6개(⑦⑧⑪⑫⑬⑭)는&lt;br&gt;논리적 설계에서 연관 개체로 분해&lt;br&gt;유도 속성(볼륨·추정 1RM 등)은&lt;br&gt;저장하지 않아 제외" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;spacingLeft=8;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="1385" y="120" width="290" height="206" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd-chen" name="ERD_Chen(가로)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="헬스 운동 볼륨 기록·분석 시스템 ERD — Chen 표기" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="8" width="900" height="34" as="geometry"/></mxCell><mxCell id="user" value="사용자" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" parent="1" vertex="1"><mxGeometry x="570.0" y="220.0" width="140" height="90" as="geometry"/></mxCell><mxCell id="user_at0" va